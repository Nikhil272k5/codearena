{
    "name": "codearena-api",
    "version": "1.0.0",
    "description": "CodeArena Backend API",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "npx esbuild src/server.ts --bundle --platform=node --outdir=dist --format=cjs --external:bcryptjs --external:mongoose --external:socket.io --external:ioredis --external:bull --external:winston --external:zod --external:cors --external:express --external:jsonwebtoken --external:dotenv --external:rate-limiter-flexible --external:uuid",
        "start": "node dist/server.js",
        "test": "jest --passWithNoTests"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "bull": "^4.12.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "ioredis": "^5.3.2",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.1.1",
        "rate-limiter-flexible": "^3.0.6",
        "socket.io": "^4.7.4",
        "uuid": "^9.0.0",
        "winston": "^3.11.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^20.11.5",
        "@types/uuid": "^9.0.7",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    }
}