# Application
NODE_ENV=development
PORT=3001

# Database
MONGO_URL=mongodb://localhost:27017/codearena
POSTGRES_URL=postgresql://codearena:password@localhost:5432/codearena_analytics

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRES_IN=7d

# Anthropic AI (Phase 5)
ANTHROPIC_API_KEY=sk-ant-xxx

# Judge0 (Optional)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-judge0-key

# Docker Execution
DOCKER_ENABLED=true
DOCKER_TIMEOUT=10000
DOCKER_MEMORY_LIMIT=256m

# WebRTC
TURN_SERVER_URL=turn:your-turn-server.com
TURN_USERNAME=username
TURN_CREDENTIAL=password

# Rate Limiting
RATE_LIMIT_SUBMISSION=10
RATE_LIMIT_CHAT=20
RATE_LIMIT_API=100

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
